{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j-store.local/spec-dev/eval-run.schema.json",
  "title": "Spec-dev behavioral evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "caseId", "caseDigest", "mode", "agent", "candidate", "trace", "traceDigest", "assertions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "caseId": {"type": "string", "minLength": 1},
    "caseDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mode": {"enum": ["baseline", "candidate", "release"]},
    "agent": {"type": "string", "minLength": 1},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillPath", "digestAlgorithm", "digest", "fileCount"],
      "properties": {
        "skillPath": {"type": "string", "minLength": 1},
        "digestAlgorithm": {"const": "sha256-tree-v1"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "fileCount": {"type": "integer", "minimum": 1}
      }
    },
    "trace": {"type": "string", "pattern": "^evals/traces/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"},
    "traceDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "worktreeDiff": {"type": "string"},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "uncertain"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
