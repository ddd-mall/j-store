{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j-store.local/spec-dev/finding.schema.json",
  "title": "Spec analysis and convergence findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeId", "findings"],
  "properties": {
    "schemaVersion": {"const": 1},
    "changeId": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "check", "severity", "blocking", "owner", "message", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "check": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "blocking": {"type": "boolean"},
          "owner": {"enum": ["intent", "current-spec", "delta", "design", "tasks", "implementation", "tests", "repository", "decision"]},
          "artifact": {"type": "string"},
          "location": {"type": "string"},
          "outcomeIds": {
            "type": "array",
            "items": {"type": "string", "pattern": "^\\S+$"},
            "uniqueItems": true
          },
          "message": {"type": "string", "minLength": 1},
          "resolutionCondition": {"type": "string"},
          "status": {"enum": ["open", "resolved", "accepted-risk"]}
        }
      }
    }
  }
}
