# Copy to .env and replace every change-me value locally. Never commit .env.
POSTGRES_DB=j_store
POSTGRES_USER=develop
POSTGRES_PASSWORD=change-me-use-a-random-local-password
POSTGRES_PORT=30432
REDIS_PORT=6379
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-use-a-random-local-grafana-password
JSTORE_PORT=8080
LOKI_PORT=3100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALLOY_PORT=12345
JSTORE_SERVICE_VERSION=dev

# Spring Boot local profile (export these in the process running Gradle/Java).
JSTORE_DB_URL=jdbc:postgresql://localhost:30432/j_store?currentSchema=develop
JSTORE_DB_USER=develop
JSTORE_DB_PASSWORD=change-me-use-the-same-local-postgres-password
JSTORE_REDIS_HOST=localhost
JSTORE_REDIS_PORT=6379
JSTORE_PHONE_VERIFICATION_HMAC_SECRET=change-me-use-at-least-32-random-bytes

# Optional user-profile HTTP query settings for split microservice deployments.
JSTORE_USER_SERVICE_URL=http://j-store-user:8080
JSTORE_USER_QUERY_TOKEN=change-me-use-an-independent-random-token-at-least-32-bytes

# External RSA JWK Set file containing the active private key and retained verification keys.
JSTORE_OIDC_ISSUER=http://127.0.0.1:8080
JSTORE_OIDC_JWK_SET_LOCATION=file:/absolute/path/to/local-signing-jwks.json
JSTORE_OIDC_ACTIVE_KEY_ID=local-v1
JSTORE_OIDC_CLIENT_ID=web
JSTORE_OIDC_CLIENT_REDIRECTS=http://127.0.0.1:3000/callback
JSTORE_OIDC_CLIENT_SCOPES=openid,profile
# Public client: keep the secret digest empty. BFF: configure a {bcrypt} digest and offline_access.
JSTORE_OIDC_CLIENT_SECRET_HASH=
JSTORE_WECHAT_ENABLED=false
JSTORE_WECHAT_APP_ID=
JSTORE_WECHAT_APP_SECRET=
JSTORE_WECHAT_CALLBACK_URI=
