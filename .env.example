# Copy to .env and replace every change-me value locally. Never commit .env.
POSTGRES_DB=j_store
POSTGRES_USER=develop
POSTGRES_PASSWORD=change-me-use-a-random-local-password
POSTGRES_PORT=30432
REDIS_PORT=6379

# Spring Boot local profile (export these in the process running Gradle/Java).
JSTORE_DB_URL=jdbc:postgresql://localhost:30432/j_store?currentSchema=develop
JSTORE_DB_USER=develop
JSTORE_DB_PASSWORD=change-me-use-the-same-local-postgres-password
JSTORE_REDIS_HOST=localhost
JSTORE_REDIS_PORT=6379
JSTORE_JWT_ACCESS_SECRET=change-me-use-a-distinct-access-secret-at-least-32-bytes
JSTORE_JWT_REFRESH_SECRET=change-me-use-a-distinct-refresh-secret-at-least-32-bytes
JSTORE_JWT_ISSUER=j-store
JSTORE_JWT_AUDIENCE=j-store-api
JSTORE_JWT_KEY_ID=local-v1
JSTORE_PHONE_VERIFICATION_HMAC_SECRET=change-me-use-at-least-32-random-bytes

# Optional user-profile HTTP query settings for split microservice deployments.
JSTORE_USER_SERVICE_URL=http://j-store-user:8080
JSTORE_USER_QUERY_TOKEN=change-me-use-an-independent-random-token-at-least-32-bytes
