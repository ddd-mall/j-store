{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddd-mall.github.io/j-store/schemas/agentic-cicd/candidate-revision.schema.json",
  "title": "CandidateRevision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_sha256",
    "base_sha",
    "candidate_revision",
    "snapshot_policy_sha256",
    "tree_sha"
  ],
  "properties": {
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tree_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
