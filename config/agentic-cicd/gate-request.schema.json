{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate_id", "issue_identifier", "candidate_revision", "runner_image", "command_policy_sha256", "validation_commands", "timeout_seconds", "requested_at"],
  "properties": {
    "gate_id": {"type": "string", "pattern": "^gate-[a-z0-9][a-z0-9-]{0,63}$"},
    "issue_identifier": {"type": "string", "pattern": "^GH-[1-9][0-9]*$"},
    "candidate_revision": {"$ref": "#/$defs/candidateRevision"},
    "runner_image": {"type": "string", "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"},
    "command_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"}},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "requested_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "candidateRevision": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_sha256", "base_sha", "candidate_revision", "snapshot_policy_sha256", "tree_sha"],
      "properties": {
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "snapshot_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    }
  }
}
