+defmodule SymphonyElixir.AgenticCicd do
+  @moduledoc """
+  Reads j-store phase policy from the image-owned trusted controller.
+  """
+
+  @controller "/opt/jstore-agentic-controller/controller.py"
+  @allowed_roles ["observer", "implementer", "reviewer", "none"]
+  @allowed_thread_sandboxes ["read-only", "workspace-write"]
+
+  @spec phase_context(Path.t(), map(), String.t() | nil) :: {:ok, map()} | {:error, term()}
+  def phase_context(_workspace, _issue, worker_host) when is_binary(worker_host) do
+    {:error, :agentic_cicd_remote_worker_not_supported}
+  end
+
+  def phase_context(workspace, %{identifier: identifier}, nil)
+      when is_binary(workspace) and is_binary(identifier) do
+    case System.cmd(
+           "/usr/bin/python3",
+           [
+             @controller,
+             "phase-context",
+             "--issue",
+             identifier,
+             "--workspace",
+             workspace
+           ],
+           stderr_to_stdout: true
+         ) do
+      {output, 0} -> decode_context(output)
+      {output, status} -> {:error, {:agentic_cicd_phase_context_failed, status, output}}
+    end
+  end
+
+  def phase_context(_workspace, _issue, _worker_host), do: {:error, :invalid_agentic_cicd_issue}
+
+  defp decode_context(output) do
+    with {:ok, context} when is_map(context) <- Jason.decode(String.trim(output)),
+         :ok <- validate_context(context) do
+      {:ok, context}
+    else
+      {:error, reason} -> {:error, {:invalid_agentic_cicd_phase_context, reason}}
+      _ -> {:error, :invalid_agentic_cicd_phase_context}
+    end
+  end
+
+  defp validate_context(context) do
+    required = [
+      "phase",
+      "role",
+      "run_model",
+      "complete_turn",
+      "thread_sandbox",
+      "turn_sandbox_policy",
+      "head_sha",
+      "candidate_revision",
+      "model_workspace"
+    ]
+
+    cond do
+      Enum.sort(Map.keys(context)) != Enum.sort(required) ->
+        {:error, :unexpected_fields}
+
+      context["role"] not in @allowed_roles ->
+        {:error, :invalid_role}
+
+      context["thread_sandbox"] not in @allowed_thread_sandboxes ->
+        {:error, :invalid_thread_sandbox}
+
+      not is_boolean(context["run_model"]) or not is_boolean(context["complete_turn"]) ->
+        {:error, :invalid_boolean}
+
+      not is_map(context["turn_sandbox_policy"]) ->
+        {:error, :invalid_turn_sandbox_policy}
+
+      not is_binary(context["head_sha"]) or
+          not String.match?(context["head_sha"], ~r/^[0-9a-f]{40}$/) ->
+        {:error, :invalid_head_sha}
+
+      context["candidate_revision"] != nil and
+          (not is_binary(context["candidate_revision"]) or
+             not String.match?(context["candidate_revision"], ~r/^[0-9a-f]{64}$/)) ->
+        {:error, :invalid_candidate_revision}
+
+      not is_binary(context["model_workspace"]) or context["model_workspace"] == "" ->
+        {:error, :invalid_model_workspace}
+
+      true ->
+        :ok
+    end
+  end
+end
