new file mode 100644
index 0000000..8b0b219
--- /dev/null
+++ b/elixir/lib/symphony_elixir/agentic_cicd.ex
@@ -0,0 +1,111 @@
+defmodule SymphonyElixir.AgenticCicd do
+  @moduledoc """
+  Narrow bridge from Symphony's scheduler to the trusted j-store host controller.
+  """
+
+  @controller "/opt/jstore-agentic-controller/controller.py"
+  @timeout_ms 120_000
+  @required_keys MapSet.new([
+                   "phase",
+                   "role",
+                   "run_model",
+                   "complete_turn",
+                   "thread_sandbox",
+                   "turn_sandbox_policy",
+                   "head_sha",
+                   "candidate_revision",
+                   "model_workspace",
+                   "base_sync",
+                   "review_packet"
+                 ])
+  @phases ["implement", "validate", "review", "complete"]
+  @roles ["observer", "implementer", "reviewer", "none"]
+
+  @spec phase_context(String.t(), map(), String.t() | nil) ::
+          {:ok, map()} | {:error, atom()}
+  def phase_context(workspace, %{identifier: identifier}, nil)
+      when is_binary(workspace) and is_binary(identifier) do
+    task =
+      Task.async(fn ->
+        System.cmd(
+          "/usr/bin/python3",
+          [
+            @controller,
+            "phase-context",
+            "--issue",
+            identifier,
+            "--workspace",
+            workspace
+          ],
+          stderr_to_stdout: true
+        )
+      end)
+
+    case Task.yield(task, @timeout_ms) do
+      {:ok, {output, 0}} -> decode_context(output)
+      {:ok, {_output, _status}} -> {:error, :phase_context_rejected}
+      nil ->
+        Task.shutdown(task, :brutal_kill)
+        {:error, :phase_context_timeout}
+    end
+  end
+
+  def phase_context(_workspace, %{identifier: identifier}, worker_host)
+      when is_binary(identifier) and is_binary(worker_host) do
+    {:error, :remote_phase_context_not_supported}
+  end
+
+  def phase_context(_workspace, _issue, _worker_host), do: {:error, :invalid_phase_context_identity}
+
+  defp decode_context(output) do
+    with {:ok, context} when is_map(context) <- Jason.decode(String.trim(output)),
+         true <- MapSet.new(Map.keys(context)) == @required_keys,
+         true <- valid_context?(context) do
+      {:ok, context}
+    else
+      _ -> {:error, :invalid_phase_context_response}
+    end
+  end
+
+  defp valid_context?(context) do
+    context["phase"] in @phases and
+      context["role"] in @roles and
+      is_boolean(context["run_model"]) and
+      is_boolean(context["complete_turn"]) and
+      context["thread_sandbox"] in ["read-only", "workspace-write"] and
+      is_map(context["turn_sandbox_policy"]) and
+      valid_sha?(context["head_sha"], 40) and
+      valid_optional_candidate?(context["candidate_revision"]) and
+      is_binary(context["model_workspace"]) and
+      Path.type(context["model_workspace"]) == :absolute and
+      valid_optional_map?(context["base_sync"]) and
+      valid_optional_map?(context["review_packet"]) and
+      valid_phase_role?(context)
+  end
+
+  defp valid_phase_role?(%{
+         "phase" => "implement",
+         "role" => role,
+         "run_model" => true
+       })
+       when role in ["observer", "implementer"],
+       do: true
+
+  defp valid_phase_role?(%{
+         "phase" => "review",
+         "role" => "reviewer",
+         "run_model" => true
+       }),
+       do: true
+
+  defp valid_phase_role?(%{
+         "phase" => phase,
+         "role" => "none",
+         "run_model" => false,
+         "complete_turn" => false
+       })
+       when phase in ["validate", "complete"],
+       do: true
+
+  defp valid_phase_role?(_context), do: false
+
+  defp valid_optional_candidate?(nil), do: true
+  defp valid_optional_candidate?(value), do: valid_sha?(value, 64)
+
+  defp valid_optional_map?(nil), do: true
+  defp valid_optional_map?(value), do: is_map(value)
+
+  defp valid_sha?(value, length) when is_binary(value) do
+    byte_size(value) == length and String.match?(value, ~r/\A[0-9a-f]+\z/)
+  end
+
+  defp valid_sha?(_value, _length), do: false
+end
