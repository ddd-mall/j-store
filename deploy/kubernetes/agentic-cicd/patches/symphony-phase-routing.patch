+defmodule SymphonyElixir.AgenticCicdTest do
+  use ExUnit.Case, async: true
+
+  alias SymphonyElixir.AgenticCicd
+
+  test "phase context is loaded only through the fixed host controller" do
+    workspace = Path.join(System.tmp_dir!(), "agentic-cicd-bridge")
+
+    assert {:ok, context} =
+             AgenticCicd.phase_context(workspace, %{identifier: "GH-50"}, nil)
+
+    assert context["phase"] == "implement"
+    assert context["role"] == "observer"
+    assert context["run_model"] == true
+    assert context["head_sha"] == String.duplicate("0", 40)
+    assert context["model_workspace"] == workspace
+  end
+
+  test "remote worker routing is rejected explicitly" do
+    assert {:error, :remote_phase_context_not_supported} =
+             AgenticCicd.phase_context(
+               "/remote/workspace",
+               %{identifier: "GH-50"},
+               "worker.example"
+             )
+  end
+
+  test "invalid issue identity is rejected before starting the controller" do
+    assert {:error, :invalid_phase_context_identity} =
+             AgenticCicd.phase_context("/workspace", %{}, nil)
+  end
+end
